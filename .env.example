# Copy to .env (gitignored). Keys stay on the server.
ANTHROPIC_API_KEY=
QLOO_API_KEY=
# QLOO_MOCK=1                 # run on labelled mock data without a Qloo key
# MARQUEE_DAILY_RUNS=25       # live runs a day across all visitors
# MARQUEE_RUNS_PER_VISITOR=3  # live runs a day per visitor (by IP address)
# MARQUEE_MODEL=claude-sonnet-5-5
# MARQUEE_DATA_DIR=/data       # private cache and daily counters (default: out/); use persistent storage when hosted
# MARQUEE_WARM_SAMPLES=1       # run uncached sample venues at start-up (the Docker image sets this)
